# ═══════════════════════════════════════════════════════════════════════════════
# SCMS Backend — Production Environment Template (.env.example)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/scms

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ─── Cloudinary Credentials ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Google Gemini AI Key ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Application Web URLs (used in Email Template Links) ───────────────────────
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# ─── Notification System & Email Provider ─────────────────────────────────────
# Provider options: smtp | resend | sendgrid | ses
EMAIL_PROVIDER=smtp

# Sender Identity
EMAIL_FROM_NAME=SCMS Support
EMAIL_FROM_ADDRESS=your-gmail-address@gmail.com
SUPPORT_EMAIL=support@scms.com

# ─── Gmail SMTP Credentials ───────────────────────────────────────────────────
# How to get Google App Password:
# 1. Turn on 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create an App Password for 'Mail' / 'Other App'
# 4. Copy the generated 16-character code into SMTP_PASS (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# ─── Alternative Providers (If EMAIL_PROVIDER is set to resend, sendgrid, or ses) ─
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxx
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxx
