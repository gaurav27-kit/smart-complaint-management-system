# ═══════════════════════════════════════════════════════════════════════════════
# SCMS Frontend — Environment Template (.env.example)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── API Target ────────────────────────────────────────────────────────────────
# URL of the Express backend API server.
# In local development: http://127.0.0.1:5000 (proxied via Vite at /api)
# In Docker Compose: http://backend:5000
# In production (Render/Railway/Vercel/VPS): https://api.yourdomain.com
VITE_BACKEND_URL=http://127.0.0.1:5000
VITE_API_URL=http://127.0.0.1:5000/api

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
